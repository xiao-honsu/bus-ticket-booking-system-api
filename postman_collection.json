            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/routes/{{routeId}}/toggle-status",
              "host": ["{{baseUrl}}"],
              "path": ["routes", "{{routeId}}", "toggle-status"]
            }
          }
        }
