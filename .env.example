# Environment
NODE_ENV=development

# Server
PORT=4000

# MongoDB
MONGODB_URL=mongodb://localhost:27017/bus-booking

# JWT
JWT_SECRET=your-secret-key-here
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# PayOS (Payment Gateway)
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# URLs for CORS and redirects
# For local development
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# For production - Comma-separated list of allowed origins
# Example: https://dsa-bus-booking.io.vn,https://www.dsa-bus-booking.io.vn,https://api.dsa-bus-booking.io.vn
ALLOWED_ORIGINS=http://localhost:3000,https://dsa-bus-booking.io.vn,https://www.dsa-bus-booking.io.vn

# Support Contact
SUPPORT_PHONE=+84-123-456-789
SUPPORT_EMAIL=support@dsa-bus-booking.io.vn

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# Logging
LOG_LEVEL=info
